<%- partial('_partial/cards', {posts: page.posts}) %>

<nav aria-label="..." class="container">
    <div class="pager">
        <div class="pre-box">
            <% if (page.prev) { %>
                <li><a href="<%- url_for(page.prev_link) %>"><span aria-hidden="true">&larr;</span> 上一页</a></li>
            <% } %>
        </div>
        <div class="pager-text">
            第<%- page.current %>页--共<%- page.total %>页
        </div>
        <div class="next-box">
            <% if (page.next) { %>
                <li><a href="<%- url_for(page.next_link) %>">下一页 <span aria-hidden="true">&rarr;</span></a></li>
            <% } %>
        </div>
    </div>
</nav>