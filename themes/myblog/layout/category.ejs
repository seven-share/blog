<%
    var allCategory=site.categories;
    var categoryTree=[];
    var getCategoryTree=function(allCate){
        allCate.map(item=>{
            if(!item.parent){
                item.childCategory=[];
                categoryTree.push(item)
            }
        })
        allCate.map(item=>{
            if(item.parent){
                categoryTree.map((parentItem,parentIndex)=>{
                    if(item.parent==parentItem._id){
                        categoryTree[parentIndex].childCategory.push(item)
                    }
                })
            }
        })        
    }
    getCategoryTree(allCategory);

    if(page.posts){
        var asc=true;
        page.posts.forEach(item=>{
            if(!item.asc){
                asc=false
            }
        })
    }
%>
<% if (!page.posts) {%>
    <div class="container list">
        <div class="row">
            <div class="col-md-6">
                <% for(var i=0;i<categoryTree.length;i++){%>
                    <% if (i % 2==0) { %>
                        <div class="panel panel-default">
                            <!-- Default panel contents -->
                            <div class="panel-heading"><a href="<%- url_for(categoryTree[i].path) %>"><%- categoryTree[i].name %></a></div>                            
                            <!-- List group -->
                            <ul class="list-group">
                                <% categoryTree[i].childCategory.map(item=>{ %>
                                    <li class="list-group-item"><a href="<%- url_for(item.path) %>"><%- item.name %><span class="badge"><%- item.length %></span></a></li>
                                <% }); %>
                            </ul>
                        </div>
                    <% } %>
                <%}%>
            </div>
            <div class="col-md-6">
                <% for(var i=0;i<categoryTree.length;i++){%>
                    <% if (i % 2==1) { %>
                        <div class="panel panel-default">
                            <!-- Default panel contents -->
                            <div class="panel-heading"><a href="<%- url_for(categoryTree[i].path) %>"><%- categoryTree[i].name %></a></div>                            
                            <!-- List group -->
                            <ul class="list-group">
                                <% categoryTree[i].childCategory.map(item=>{ %>
                                    <li class="list-group-item"><a href="<%- url_for(item.path) %>"><%- item.name %><span class="badge"><%- item.length %></span></a></li>
                                <% }); %>
                            </ul>
                        </div>
                    <% } %>
                <%}%>
            </div>
        </div>
    </div>
<% }else{ %>
    <% if (asc) { %>
        <%- partial('_partial/cards', {posts: page.posts.sort('date')}) %>
    <% } else { %>
        <%- partial('_partial/cards', {posts: page.posts}) %>
    <% } %>
    <nav aria-label="..." class="container">
        <div class="pager">
            <div class="pre-box">
                <% if (page.prev) { %>
                    <li><a href="<%- url_for(page.prev_link) %>"><span aria-hidden="true">&larr;</span> 上一页</a></li>
                <% } %>
            </div>
            <div class="pager-text">
                第<%- page.current %>页--共<%- page.total %>页
            </div>
            <div class="next-box">
                <% if (page.next) { %>
                    <li><a href="<%- url_for(page.next_link) %>">下一页 <span aria-hidden="true">&rarr;</span></a></li>
                <% } %>
            </div>
        </div>
    </nav>
<% } %>
